<script>
const bpCustomers = <?php echo json_encode(array_map(function($c) {
    return ['id' => $c->id, 'name' => $c->name, 'business' => $c->business_name ?? '', 'phone' => $c->phone_number ?? ''];
}, $unlinked_customers)); ?>;
const bpSuppliers = <?php echo json_encode(array_map(function($s) {
    return ['id' => $s->id, 'name' => $s->company_name, 'phone' => trim(($s->phone ?? '') . ' ' . ($s->mobile ?? ''))];
}, $unlinked_suppliers)); ?>;

function bpSearchCustomers(query) {
    const dd = document.getElementById('bp_cust_dropdown');
    const q = query.toLowerCase().trim();
    if (q.length === 0) { dd.classList.add('hidden'); document.getElementById('bp_cust_id').value = ''; return; }
    const matches = bpCustomers.filter(c => c.name.toLowerCase().includes(q) || c.business.toLowerCase().includes(q) || c.phone.includes(q)).slice(0, 20);
    dd.innerHTML = matches.length === 0 ? '<div class="px-3 py-2 text-sm text-gray-500">No unlinked customers found</div>' :
        matches.map(c => `<div class="px-3 py-2 hover:bg-rose-50 cursor-pointer text-sm border-b border-gray-100" onclick="bpSelectCustomer(${c.id})">
            <span class="font-medium text-gray-900">${c.name}</span>${c.business ? `<span class="text-gray-400 text-xs ml-1">(${c.business})</span>` : ''}
            <span class="text-gray-400 text-xs ml-2">${c.phone}</span></div>`).join('');
    dd.classList.remove('hidden');
}
function bpSelectCustomer(id) {
    const c = bpCustomers.find(x => x.id === id);
    if (!c) return;
    document.getElementById('bp_cust_id').value = c.id;
    document.getElementById('bp_cust_search').value = c.name;
    document.getElementById('bp_cust_dropdown').classList.add('hidden');
}
function bpSearchSuppliers(query) {
    const dd = document.getElementById('bp_sup_dropdown');
    const q = query.toLowerCase().trim();
    if (q.length === 0) { dd.classList.add('hidden'); document.getElementById('bp_sup_id').value = ''; return; }
    const matches = bpSuppliers.filter(s => s.name.toLowerCase().includes(q) || s.phone.includes(q)).slice(0, 20);
    dd.innerHTML = matches.length === 0 ? '<div class="px-3 py-2 text-sm text-gray-500">No unlinked suppliers found</div>' :
        matches.map(s => `<div class="px-3 py-2 hover:bg-rose-50 cursor-pointer text-sm border-b border-gray-100" onclick="bpSelectSupplier(${s.id})">
            <span class="font-medium text-gray-900">${s.name}</span><span class="text-gray-400 text-xs ml-2">${s.phone}</span></div>`).join('');
    dd.classList.remove('hidden');
}
function bpSelectSupplier(id) {
    const s = bpSuppliers.find(x => x.id === id);
    if (!s) return;
    document.getElementById('bp_sup_id').value = s.id;
    document.getElementById('bp_sup_search').value = s.name;
    document.getElementById('bp_sup_dropdown').classList.add('hidden');
}
document.addEventListener('click', e => {
    if (!e.target.closest('#bp_cust_search') && !e.target.closest('#bp_cust_dropdown')) document.getElementById('bp_cust_dropdown').classList.add('hidden');
    if (!e.target.closest('#bp_sup_search') && !e.target.closest('#bp_sup_dropdown')) document.getElementById('bp_sup_dropdown').classList.add('hidden');
});
document.getElementById('bpLinkForm').addEventListener('submit', function(e) {
    if (!document.getElementById('bp_cust_id').value) { e.preventDefault(); alert('Please select a customer from the dropdown.'); return; }
    if (!document.getElementById('bp_sup_id').value) { e.preventDefault(); alert('Please select a supplier from the dropdown.'); }
});
</script>
