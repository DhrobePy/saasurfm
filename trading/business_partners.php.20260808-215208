<?php
/**
 * Business Partners — links a customer record and a supplier record that are
 * the same real-world party (Ujjal both buys from and sells to them). This is
 * an ADDITIVE linking layer, not a merge: customers.business_partner_id and
 * suppliers.business_partner_id are nullable columns pointing at one shared
 * business_partners row. Every existing customer/supplier page keeps working
 * completely unchanged.
 *
 * Design: /Users/apple/Desktop/saas/COMMODITY_TRADING_PLAN.md §2
 */
require_once '../core/init.php';

restrict_access(['Superadmin', 'admin'], 'trading', 'business_partners');

global $db;
$currentUser = getCurrentUser();
$user_id     = $currentUser['id'] ?? null;
$pageTitle   = 'Business Partners';

ensureBusinessPartnersTable();

$csrf = $_SESSION['csrf_token'] ?? '';

// ── POST actions ─────────────────────────────────────────────────────────
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $action = $_POST['action'] ?? '';
    try {
        if (!hash_equals($csrf, $_POST['csrf_token'] ?? '')) {
            throw new Exception('Invalid security token — refresh the page and try again.');
        }

        if ($action === 'create_link') {
            $customer_id  = (int)($_POST['customer_id'] ?? 0);
            $supplier_id  = (int)($_POST['supplier_id'] ?? 0);
            $partner_name = trim($_POST['partner_name'] ?? '');
            if (!$customer_id || !$supplier_id) throw new Exception('Pick both a customer and a supplier to link.');

            $cust = $db->query("SELECT id, name, business_partner_id FROM customers WHERE id = ?", [$customer_id])->first();
            $supp = $db->query("SELECT id, company_name, business_partner_id FROM suppliers WHERE id = ?", [$supplier_id])->first();
            if (!$cust) throw new Exception('Customer not found.');
            if (!$supp) throw new Exception('Supplier not found.');

            $cust_pid = $cust->business_partner_id ? (int)$cust->business_partner_id : null;
            $supp_pid = $supp->business_partner_id ? (int)$supp->business_partner_id : null;

            if ($cust_pid && $supp_pid && $cust_pid !== $supp_pid) {
                throw new Exception('This customer and supplier are already linked to two DIFFERENT partners — unlink one side first.');
            }

            // Reuse whichever side already has a partner; otherwise create one.
            $partner_id = $cust_pid ?: $supp_pid;
            if (!$partner_id) {
                $partner_id = $db->insert('business_partners', [
                    'partner_name'       => $partner_name !== '' ? $partner_name : $cust->name,
                    'created_by_user_id' => $user_id,
                ]);
                if (!$partner_id) throw new Exception('Failed to create the partner record.');
            }

            $db->query("UPDATE customers SET business_partner_id = ? WHERE id = ?", [$partner_id, $customer_id]);
            $db->query("UPDATE suppliers SET business_partner_id = ? WHERE id = ?", [$partner_id, $supplier_id]);

            auditLog('customer', 'updated',
                "Linked customer '{$cust->name}' (#{$customer_id}) with supplier '{$supp->company_name}' (#{$supplier_id}) "
                . "as Business Partner #{$partner_id} by " . ($currentUser['display_name'] ?? 'admin'), []);

            $_SESSION['success_flash'] = "Linked \"{$cust->name}\" (customer) with \"{$supp->company_name}\" (supplier) as one Business Partner.";

        } elseif ($action === 'unlink') {
            $partner_id = (int)($_POST['partner_id'] ?? 0);
            $side       = $_POST['side'] ?? '';
            if (!$partner_id || !in_array($side, ['customer', 'supplier'], true)) throw new Exception('Invalid unlink request.');

            if ($side === 'customer') {
                $db->query("UPDATE customers SET business_partner_id = NULL WHERE business_partner_id = ?", [$partner_id]);
            } else {
                $db->query("UPDATE suppliers SET business_partner_id = NULL WHERE business_partner_id = ?", [$partner_id]);
            }
            auditLog('customer', 'updated',
                "Business Partner #{$partner_id} — {$side} side unlinked by " . ($currentUser['display_name'] ?? 'admin'), []);
            $_SESSION['success_flash'] = 'Unlinked. (Re-link any time — nothing was deleted.)';
        }
    } catch (Exception $e) {
        $_SESSION['error_flash'] = $e->getMessage();
    }
    header('Location: business_partners.php');
    exit;
}

// ── Data for render ──────────────────────────────────────────────────────
$linked = getLinkedBusinessPartners();

// Unlinked customers/suppliers, for the link form + auto-suggest.
$unlinked_customers = $db->query(
    "SELECT id, name, business_name, phone_number FROM customers
     WHERE status = 'active' AND business_partner_id IS NULL ORDER BY name ASC"
)->results();
$unlinked_suppliers = $db->query(
    "SELECT id, company_name, phone, mobile FROM suppliers
     WHERE status = 'active' AND business_partner_id IS NULL ORDER BY company_name ASC"
)->results();

// Suggest matches by phone number — suggestion only, never auto-linked.
$suggestions = [];
foreach ($unlinked_customers as $c) {
    if (empty($c->phone_number)) continue;
    foreach ($unlinked_suppliers as $s) {
        if ($c->phone_number === $s->phone || $c->phone_number === $s->mobile) {
            $suggestions[] = ['customer' => $c, 'supplier' => $s, 'reason' => 'same phone number'];
        }
    }
}

$flash = $_SESSION['success_flash'] ?? null; unset($_SESSION['success_flash']);
$err   = $_SESSION['error_flash']   ?? null; unset($_SESSION['error_flash']);

