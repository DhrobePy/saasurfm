<?php
/**
 * Commodity Sale — dedicated flow for reselling purchased commodities directly
 * (e.g. surplus wheat), separate from the milled-flour Credit Sales pipeline.
 * No production step: post directly, decrement real inventory, recognize both
 * revenue AND cost of goods sold (weighted-average costing) so gross margin is
 * real, not estimated.
 *
 * Design: /Users/apple/Desktop/saas/COMMODITY_TRADING_PLAN.md
 *
 * Approval: Superadmin/admin always post directly. A non-admin posts directly
 * ONLY if they have a delegated 'commodity_sale' ৳ limit covering the amount
 * AND the global "require approval for every commodity sale" policy is off —
 * otherwise it queues in the shared Approval Requests inbox (cr/approval_requests.php),
 * reusing the exact same maker/checker engine as payments/deliveries. A user
 * with NO limit configured always queues — absence of a limit is never treated
 * as unlimited trust (matches the collect_payment fix).
 *
 * Stock: warn + override, not a hard block — real trading sometimes sells
 * against incoming stock not yet received.
 */
require_once '../core/init.php';

restrict_access(['Superadmin', 'admin'], 'trading', 'commodity_sale');

global $db;
$currentUser = getCurrentUser();
$user_id     = $currentUser['id'] ?? null;
$is_admin    = in_array($currentUser['role'] ?? '', ['Superadmin', 'admin'], true);
$can_delete  = $is_admin || userCanPageAction('trading', 'commodity_sale', 'can_delete');
$pageTitle   = 'Commodity Sale';

ensureBusinessPartnersTable();
ensureCommodityIsSellableColumn();
ensureCommodityInventoryTable();
ensureCommoditySalesTable();

$csrf = $_SESSION['csrf_token'] ?? '';

// ── Checker executing an approved request? Load it for the prefill banner. ──
$preq          = null;
$preq_error    = null;
$preq_id_get   = isset($_GET['pending_req']) ? (int)$_GET['pending_req'] : 0;
if ($preq_id_get) {
    $preq = getPendingRequest($preq_id_get, 'commodity_sale');
    if (!$preq) {
        $preq_error = "Request #{$preq_id_get} is not open — it may already be approved, rejected, or cancelled.";
    } elseif (!$is_admin) {
        $my_cap = getUserActionLimit((int)$user_id, 'commodity_sale');
        if ($my_cap !== null && (float)$preq->amount > $my_cap) {
            $preq_error = "Request #{$preq_id_get} (৳" . number_format((float)$preq->amount, 0) . ") exceeds your delegated limit (৳" . number_format($my_cap, 0) . ") — a more senior officer must post it.";
            $preq = null;
        }
    }
}

// ── POST: create sale ────────────────────────────────────────────────────
$error = null;
if ($_SERVER['REQUEST_METHOD'] === 'POST' && ($_POST['action'] ?? '') === 'create_commodity_sale') {
    try {
        if (!hash_equals($csrf, $_POST['csrf_token'] ?? '')) {
            throw new Exception('Invalid security token — refresh the page and try again.');
        }

        $customer_id   = (int)($_POST['customer_id'] ?? 0);
        $commodity_id  = (int)($_POST['commodity_id'] ?? 0);
        $branch_id     = (int)($_POST['branch_id'] ?? 0);
        $origin        = trim($_POST['origin'] ?? '');
        $source_po_id  = !empty($_POST['source_purchase_order_id']) ? (int)$_POST['source_purchase_order_id'] : null;
        $quantity      = (float)($_POST['quantity'] ?? 0);
        $unit_price    = (float)($_POST['unit_price'] ?? 0);
        $advance_paid  = (float)($_POST['advance_paid'] ?? 0);
        $notes         = trim($_POST['notes'] ?? '');
        $stock_override = !empty($_POST['stock_override']);
        $exec_pending_req_id = (int)($_POST['pending_req_id'] ?? 0);

        // Backdated sale_date for reconciliation (Superadmin/admin only). Never
        // trust the POST value for non-admins — always today, regardless of what
        // was submitted (defense in depth, mirrors create_order.php's order_date).
        // "backdated" means past, not pre-dated.
        $today = date('Y-m-d');
        $sale_date = $today;
        if ($is_admin && !empty($_POST['sale_date'])) {
            $posted_date = trim($_POST['sale_date']);
            if (preg_match('/^\d{4}-\d{2}-\d{2}$/', $posted_date) && strtotime($posted_date) !== false) {
                if ($posted_date <= $today) {
                    $sale_date = $posted_date;
                } else {
                    throw new Exception('Sale date cannot be in the future.');
                }
            }
        }

        if (!$customer_id)   throw new Exception('Please select a customer.');
        if (!$commodity_id)  throw new Exception('Please select a commodity.');
        if (!$branch_id)     throw new Exception('Please select a branch.');
        if ($quantity <= 0)  throw new Exception('Quantity must be greater than zero.');
        if ($unit_price < 0) throw new Exception('Unit price cannot be negative.');

        $commodity = $db->query("SELECT * FROM purchase_commodities WHERE id = ? AND is_sellable = 1", [$commodity_id])->first();
        if (!$commodity) throw new Exception('Commodity not found or not marked sellable.');
        if (empty($commodity->inventory_account_id)) {
            throw new Exception("\"{$commodity->name}\" has no Inventory account configured — set one in Purchase → Procurement Catalog before selling it.");
        }

        $customer = $db->query("SELECT id, name FROM customers WHERE id = ?", [$customer_id])->first();
        if (!$customer) throw new Exception('Customer not found.');

        // Stock guard: warn + override, not a hard block (design decision).
        // Scoped to the chosen origin's OWN pool — different origins are costed
        // and stocked separately, so "on hand" here means that origin only.
        $stock = getCommodityInventory($commodity_id, $branch_id, $origin);
        if ($quantity > $stock['quantity_on_hand'] && !$stock_override) {
            throw new Exception(sprintf(
                'This exceeds current stock (on hand: %s %s%s). Tick "sell anyway" to override if this is against incoming stock.',
                number_format($stock['quantity_on_hand'], 3), $commodity->unit, $origin !== '' ? " of {$origin} origin" : ''
            ));
        }

        $total_amount = round($quantity * $unit_price, 2);
        $balance_due  = max(0, $total_amount - $advance_paid);

        // ── Maker/checker gate (mirrors customer_payment.php exactly) ───────
        if (!$is_admin) {
            $my_limit  = getUserActionLimit((int)$user_id, 'commodity_sale');
            $over_limit = $my_limit !== null && $total_amount > $my_limit;

            if ($exec_pending_req_id) {
                // Checker posting an approved request → never re-queue; only
                // enforce that the checker's own limit covers it.
                if ($over_limit) {
                    throw new Exception('Your commodity-sale limit (৳' . number_format($my_limit, 0)
                        . ') does not cover this ৳' . number_format($total_amount, 0) . ' sale — a more senior officer must post it.');
                }
            } else {
                $no_limit_configured = $my_limit === null;
                $needs_approval = commoditySaleApprovalRequiredForAll() || $over_limit || $no_limit_configured;
                if ($needs_approval) {
                    $req_id = submitPendingRequest('commodity_sale', $total_amount, [
                        'customer_id'  => $customer_id,
                        'commodity_id' => $commodity_id,
                        'branch_id'    => $branch_id,
                        'origin'       => $origin,
                        'source_purchase_order_id' => $source_po_id,
                        'sale_date'    => $sale_date,
                        'quantity'     => $quantity,
                        'unit_price'   => $unit_price,
                        'advance_paid' => $advance_paid,
                        'notes'        => $notes,
                        'stock_override' => $stock_override ? 1 : 0,
                    ], [
                        'customer_id' => $customer_id,
                        'summary'     => "Sell {$quantity} {$commodity->unit} {$commodity->name} to {$customer->name} @ ৳{$unit_price} = ৳" . number_format($total_amount, 0),
                        'maker_limit' => $my_limit,
                    ]);
                    if (!$req_id) throw new Exception('Could not queue this sale for approval. Please try again.');
                    $reason = $over_limit ? 'over ৳' . number_format($my_limit, 0) . ' limit' : ($no_limit_configured ? 'no commodity-sale limit configured for this user' : 'commodity sale approval policy');
                    auditLog('other', 'created', "Commodity sale of {$quantity} {$commodity->unit} {$commodity->name} to {$customer->name} queued for approval ({$reason}) by " . ($currentUser['display_name'] ?? 'user'));
                    $_SESSION['success_flash'] = "This sale (৳" . number_format($total_amount, 0) . ") was sent for approval. It will post once a senior officer approves it.";
                    header('Location: commodity_sale.php');
                    exit();
                }
            }
        }

        // ── Post directly (admin, or a checker/maker whose limit covers it) ──
        $pdo = $db->getPdo();
        $pdo->beginTransaction();

        $date_prefix = date('Ymd', strtotime($sale_date));
        $last = $db->query("SELECT sale_number FROM commodity_sales WHERE sale_number LIKE ? ORDER BY id DESC LIMIT 1", ["TR-{$date_prefix}-%"])->first();
        $seq  = $last ? ((int)substr($last->sale_number, -4) + 1) : 1;
        $sale_number = sprintf("TR-%s-%04d", $date_prefix, $seq);

        // COGS at the moment of sale (also decrements commodity_inventory).
        $cogs_amount = postCommoditySaleCost($commodity_id, $branch_id, $quantity, $origin);

        // Credit the ORIGINAL maker when a checker is posting an approved request
        // (audit trail should show who actually initiated the sale).
        $sale_creator_id = $user_id;
        if ($exec_pending_req_id && $preq && !empty($preq->maker_user_id)) {
            $sale_creator_id = (int)$preq->maker_user_id;
        }

        $sale_id = $db->insert('commodity_sales', [
            'sale_number'        => $sale_number,
            'customer_id'        => $customer_id,
            'commodity_id'       => $commodity_id,
            'branch_id'          => $branch_id,
            'origin'             => $origin,
            'source_purchase_order_id' => $source_po_id,
            'sale_date'          => $sale_date,
            'quantity'           => $quantity,
            'unit_price'         => $unit_price,
            'total_amount'       => $total_amount,
            'cogs_amount'        => $cogs_amount,
            'advance_paid'       => $advance_paid,
            'amount_paid'        => 0,
            'balance_due'        => $balance_due,
            'stock_overridden'   => $stock_override ? 1 : 0,
            'status'             => 'approved',
            'notes'              => $notes ?: null,
            'created_by_user_id' => $sale_creator_id,
            'approved_by_user_id'=> $user_id,
        ]);
        if (!$sale_id) throw new Exception('Failed to create the sale record.');

        // ── One compound journal entry: DR AR / CR Revenue / DR COGS / CR Inventory ──
        $ar_account = $db->query("SELECT id FROM chart_of_accounts WHERE account_type = 'Accounts Receivable' LIMIT 1")->first();
        if (!$ar_account) throw new Exception("Chart of Accounts is missing an 'Accounts Receivable' account.");
        $gl = ensureCommodityTradingAccounts();

        $journal_desc = "Commodity sale {$sale_number}: {$quantity} {$commodity->unit} {$commodity->name} to {$customer->name}";
        $journal_id = $db->insert('journal_entries', [
            'transaction_date'      => $sale_date,
            'description'           => $journal_desc,
            'related_document_type' => 'commodity_sales',
            'related_document_id'   => $sale_id,
            'created_by_user_id'    => $user_id,
        ]);
        if (!$journal_id) throw new Exception('Failed to create the journal entry.');

        $db->insert('transaction_lines', ['journal_entry_id' => $journal_id, 'account_id' => $ar_account->id, 'debit_amount' => $total_amount, 'credit_amount' => 0, 'description' => $journal_desc]);
        $db->insert('transaction_lines', ['journal_entry_id' => $journal_id, 'account_id' => $gl['revenue_account_id'], 'debit_amount' => 0, 'credit_amount' => $total_amount, 'description' => $journal_desc]);
        if ($cogs_amount > 0) {
            $db->insert('transaction_lines', ['journal_entry_id' => $journal_id, 'account_id' => $gl['cogs_account_id'], 'debit_amount' => $cogs_amount, 'credit_amount' => 0, 'description' => $journal_desc . ' (COGS)']);
            $db->insert('transaction_lines', ['journal_entry_id' => $journal_id, 'account_id' => $commodity->inventory_account_id, 'debit_amount' => 0, 'credit_amount' => $cogs_amount, 'description' => $journal_desc . ' (inventory drawdown)']);
        }
        $db->query("UPDATE commodity_sales SET journal_entry_id = ? WHERE id = ?", [$journal_id, $sale_id]);

        // ── Customer ledger — transaction_type='invoice' so this behaves like
        // any other invoice in the customer's statement/true-balance (ENUM-safe:
        // 'invoice' is a valid customer_ledger.transaction_type value). ──
        $agg = $db->query("SELECT COALESCE(SUM(debit_amount),0) td, COALESCE(SUM(credit_amount),0) tc FROM customer_ledger WHERE customer_id = ?", [$customer_id])->first();
        $cust_init = $db->query("SELECT initial_due FROM customers WHERE id = ?", [$customer_id])->first();
        $prev_balance = ((float)$agg->td > 0 || (float)$agg->tc > 0) ? ((float)$agg->td - (float)$agg->tc) : (float)($cust_init->initial_due ?? 0);
        $balance_after = $prev_balance + $total_amount;

        $db->insert('customer_ledger', [
            'customer_id'        => $customer_id,
            'transaction_date'   => $sale_date,
            'transaction_type'   => 'invoice',
            'reference_type'     => 'commodity_sales',
            'reference_id'       => $sale_id,
            'invoice_number'     => $sale_number,
            'description'        => "Commodity sale — {$sale_number} ({$quantity} {$commodity->unit} {$commodity->name})",
            'debit_amount'       => $total_amount,
            'credit_amount'      => 0,
            'balance_after'      => $balance_after,
            'created_by_user_id' => $user_id,
            'journal_entry_id'   => $journal_id,
        ]);

        if ($exec_pending_req_id) {
            decidePendingRequest($exec_pending_req_id, 'approved', 'Posted by ' . ($currentUser['display_name'] ?? 'checker'), $sale_number);
        }

        $pdo->commit();

        auditLog('other', 'created',
            "Commodity sale {$sale_number}: {$quantity} {$commodity->unit} {$commodity->name} to {$customer->name} — ৳" . number_format($total_amount, 2)
            . " (COGS ৳" . number_format($cogs_amount, 2) . ", margin ৳" . number_format($total_amount - $cogs_amount, 2) . ")"
            . ($stock_override ? ' — STOCK OVERRIDDEN' : '') . " by " . ($currentUser['display_name'] ?? 'user'));

        if (defined('TELEGRAM_NOTIFICATIONS_ENABLED') && TELEGRAM_NOTIFICATIONS_ENABLED
            && defined('TELEGRAM_BOT_TOKEN') && defined('TELEGRAM_CHAT_ID')) {
            try {
                require_once '../core/classes/TelegramNotifier.php';
                $margin = $total_amount - $cogs_amount;
                (new TelegramNotifier(TELEGRAM_BOT_TOKEN, getTelegramChatId('orders')))->sendMessage(
                    "<b>🔁 COMMODITY SALE POSTED</b>\n───────────────────────────────\n\n"
                    . "• Sale: <code>{$sale_number}</code>\n• Customer: <b>" . htmlspecialchars($customer->name) . "</b>\n"
                    . "• {$quantity} {$commodity->unit} {$commodity->name} @ ৳{$unit_price}\n"
                    . "• Total: ৳" . number_format($total_amount, 0) . " · COGS: ৳" . number_format($cogs_amount, 0) . " · Margin: ৳" . number_format($margin, 0) . "\n"
                    . ($stock_override ? "• ⚠ Stock override used (sold beyond on-hand quantity)\n" : '')
                    . "• Posted by: " . ($currentUser['display_name'] ?? 'user')
                );
            } catch (\Throwable $te) { error_log('commodity_sale Telegram: ' . $te->getMessage()); }
        }

        $_SESSION['success_flash'] = "Commodity sale {$sale_number} posted — ৳" . number_format($total_amount, 2)
            . " (margin ৳" . number_format($total_amount - $cogs_amount, 2) . "). Collect payment from the customer's ledger.";
        header('Location: commodity_sale.php');
        exit();

    } catch (Exception $e) {
        if (isset($pdo) && $pdo->inTransaction()) $pdo->rollBack();
        $error = $e->getMessage();
    }
}

