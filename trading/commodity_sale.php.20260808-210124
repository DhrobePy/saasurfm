<script>
const csCustomers = <?php echo json_encode(array_map(function($c) {
    return ['id' => $c->id, 'name' => $c->name, 'business' => $c->business_name ?? '', 'phone' => $c->phone_number ?? '',
            'balance' => (float)$c->true_balance, 'isPartner' => !empty($c->business_partner_id)];
}, $customers)); ?>;
const csInventory = <?php echo json_encode(array_map(function($r) {
    return ['commodity_id' => (int)$r->commodity_id, 'branch_id' => (int)$r->branch_id, 'origin' => $r->origin, 'qty' => (float)$r->quantity_on_hand, 'avgCost' => (float)$r->weighted_avg_cost];
}, $inventory_rows)); ?>;
const csLastSalePrice = <?php echo json_encode($last_sale_price); ?>;
const csOriginsByCommodity = <?php echo json_encode($origins_by_commodity); ?>;
const csPosByCommodity = <?php echo json_encode($pos_by_commodity); ?>;

function csSearchCustomers(query) {
    const dd = document.getElementById('cs_customer_dropdown');
    const q = query.toLowerCase().trim();
    const matches = q.length === 0 ? csCustomers.slice(0, 20) : csCustomers.filter(c =>
        c.name.toLowerCase().includes(q) || c.business.toLowerCase().includes(q) || c.phone.includes(q)
    ).slice(0, 20);
    dd.innerHTML = matches.length === 0 ? '<div class="px-4 py-3 text-sm text-gray-500">No customers found</div>' :
        matches.map(c => `<div class="px-4 py-2 hover:bg-rose-50 cursor-pointer text-sm border-b border-gray-100" onclick="csSelectCustomer(${c.id})">
            <span class="font-medium text-gray-900">${c.name}</span>
            ${c.business ? `<span class="text-gray-400 text-xs ml-1">(${c.business})</span>` : ''}
            ${c.isPartner ? '<span class="ml-1 text-[10px] px-1.5 py-0.5 bg-amber-100 text-amber-700 rounded-full">Business Partner</span>' : ''}
            <span class="text-gray-400 text-xs ml-2">${c.phone}</span>
        </div>`).join('');
    dd.classList.remove('hidden');
}
function csSelectCustomer(id) {
    const c = csCustomers.find(x => x.id === id);
    if (!c) return;
    document.getElementById('cs_customer_id').value = c.id;
    document.getElementById('cs_customer_search').value = c.name;
    document.getElementById('cs_customer_dropdown').classList.add('hidden');
    const hint = document.getElementById('cs_partner_hint');
    if (c.isPartner) {
        hint.textContent = 'This customer is a linked Business Partner — check Trading → Business Partners for their combined position.';
        hint.classList.remove('hidden');
    } else {
        hint.classList.add('hidden');
    }
}
document.addEventListener('click', e => {
    if (!e.target.closest('#cs_customer_search') && !e.target.closest('#cs_customer_dropdown')) {
        document.getElementById('cs_customer_dropdown').classList.add('hidden');
    }
});

function csCommodityChanged() {
    const commodityId = parseInt(document.getElementById('cs_commodity').value) || 0;
    const originSel = document.getElementById('cs_origin');
    const currentOrigin = originSel.value;
    const origins = csOriginsByCommodity[commodityId] || [];
    originSel.innerHTML = '<option value="">Not tracked / mixed</option>' + origins.map(o => `<option value="${o}">${o}</option>`).join('');
    if (origins.includes(currentOrigin)) originSel.value = currentOrigin;

    const poSel = document.getElementById('cs_source_po');
    const currentPo = poSel.value;
    const pos = csPosByCommodity[commodityId] || [];
    poSel.innerHTML = '<option value="">Not linked</option>' + pos.map(p => `<option value="${p.id}">${p.label}</option>`).join('');
    if (pos.some(p => String(p.id) === currentPo)) poSel.value = currentPo;

    csUpdateStock();
}

function csUpdateStock() {
    const commodityId = parseInt(document.getElementById('cs_commodity').value) || 0;
    const branchId = parseInt(document.getElementById('cs_branch').value) || 0;
    const origin = document.getElementById('cs_origin').value;
    const opt = document.getElementById('cs_commodity').selectedOptions[0];
    document.getElementById('cs_qty_unit').textContent = opt && opt.dataset.unit ? '(' + opt.dataset.unit + ')' : '';

    const priceHint = document.getElementById('cs_price_hint');
    const hints = [];
    if (commodityId && csLastSalePrice[commodityId] !== undefined) hints.push('last sale price: ৳' + parseFloat(csLastSalePrice[commodityId]).toFixed(2));

    const infoBox = document.getElementById('cs_stock_info');
    const overrideBox = document.getElementById('cs_override_box');
    if (!commodityId || !branchId) { infoBox.classList.add('hidden'); overrideBox.classList.add('hidden'); priceHint.textContent = hints.join(' · '); return; }

    const inv = csInventory.find(i => i.commodity_id === commodityId && i.branch_id === branchId && i.origin === origin);
    const qtyOnHand = inv ? inv.qty : 0;
    const avgCost = inv ? inv.avgCost : 0;
    if (avgCost > 0) hints.push('weighted-avg cost: ৳' + avgCost.toFixed(2));
    priceHint.textContent = hints.join(' · ');

    const unit = opt && opt.dataset.unit ? opt.dataset.unit : '';
    const originLabel = origin ? ` (${origin})` : '';
    infoBox.className = 'rounded-lg border p-3 text-sm ' + (qtyOnHand > 0 ? 'border-blue-200 bg-blue-50 text-blue-900' : 'border-gray-200 bg-gray-50 text-gray-600');
    infoBox.textContent = `On hand at this source${originLabel}: ${qtyOnHand.toFixed(3)} ${unit}`;
    infoBox.classList.remove('hidden');

    const qty = parseFloat(document.getElementById('cs_quantity').value) || 0;
    if (qty > qtyOnHand) {
        overrideBox.classList.remove('hidden');
    } else {
        overrideBox.classList.add('hidden');
        document.getElementById('cs_override_chk').checked = false;
    }
}

function csCalcTotal() {
    const qty = parseFloat(document.getElementById('cs_quantity').value) || 0;
    const price = parseFloat(document.getElementById('cs_price').value) || 0;
    const advance = parseFloat(document.getElementById('cs_advance').value) || 0;
    const total = qty * price;
    document.getElementById('cs_total').textContent = '৳' + total.toFixed(2);
    document.getElementById('cs_due').textContent = '৳' + Math.max(0, total - advance).toFixed(2);
}

document.getElementById('commSaleForm').addEventListener('submit', function(e) {
    if (!document.getElementById('cs_customer_id').value) {
        e.preventDefault(); alert('Please select a customer.'); return;
    }
    const overrideBox = document.getElementById('cs_override_box');
    if (!overrideBox.classList.contains('hidden') && !document.getElementById('cs_override_chk').checked) {
        e.preventDefault();
        alert('This sale exceeds current stock on hand. Tick the override checkbox to confirm, or reduce the quantity.');
    }
});

function csDeleteSale(saleId, saleNumber) {
    const reason = prompt('Delete/reverse sale ' + saleNumber + ' — this moves it to the Recycle Bin, restores the stock, and reverses the ledger entry. Reason (required):');
    if (reason === null) return;
    if (!reason.trim()) { alert('A reason is required.'); return; }
    const fd = new FormData();
    fd.append('sale_id', saleId);
    fd.append('reason', reason.trim());
    fd.append('csrf_token', <?php echo json_encode($csrf); ?>);
    fetch('delete_commodity_sale.php', { method: 'POST', body: fd, headers: { 'X-CSRF-Token': <?php echo json_encode($csrf); ?> } })
        .then(r => r.json())
        .then(data => {
            if (data.success) { alert(data.message); location.reload(); }
            else { alert('Could not delete: ' + data.message); }
        })
        .catch(() => alert('Network error — please try again.'));
}

