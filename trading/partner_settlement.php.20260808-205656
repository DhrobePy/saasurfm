<script>
function psUpdate() {
    const sel = document.getElementById('ps_partner');
    const opt = sel.selectedOptions[0];
    const box = document.getElementById('ps_position');
    if (!opt || !opt.value) { box.classList.add('hidden'); return; }
    const ar = parseFloat(opt.dataset.ar) || 0;
    const ap = parseFloat(opt.dataset.ap) || 0;
    const max = Math.min(ar, ap);
    document.getElementById('ps_ar').textContent = '৳' + ar.toFixed(2);
    document.getElementById('ps_ap').textContent = '৳' + ap.toFixed(2);
    document.getElementById('ps_max').textContent = '৳' + max.toFixed(2);
    document.getElementById('ps_amount').max = max;
    document.getElementById('ps_amount').value = max > 0 ? max.toFixed(2) : '';
    box.classList.remove('hidden');
}
document.addEventListener('DOMContentLoaded', psUpdate);
</script>
